.env
__pycache__/
*.pyc
.claude/settings.local.json

# Real financial documents (real account numbers, IFSC/MICR codes, real
# names and addresses for an actual charitable trust) -- must never reach
# the public GitHub repo. Fabricated/sample data stays out of this rule.
data/real_docs/
data/ledger.db
dashboard/ledger.html

# Evidence files uploaded through the admin interface when running locally
# without R2 configured (tools/r2.py) -- same real-data sensitivity as
# data/real_docs/ above.
data/uploaded/

# Generated demo data/output (fabricated, not sensitive -- excluded just
# for consistency with the rule above, not because it needs protecting).
data/demo/ledger_demo.db
data/demo/evidence/
dashboard/demo_ledger.html
