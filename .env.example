ANTHROPIC_API_KEY=

# Only needed for the hosted deployment (server/app.py). Leave unset for
# local pipeline runs / local static dashboard builds -- those default to
# the local SQLite file at data/ledger.db.

# Postgres connection string for the hosted database, e.g.
# postgres://user:password@host:5432/dbname
DATABASE_URL=

# The dashboard's login password, hashed -- never store it in plaintext.
# Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
DASHBOARD_PASSWORD_HASH=

# Random string used to sign the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Cloudflare R2 (evidence file storage for the hosted deployment). Leave
# all four unset for local runs -- the server and
# scripts/upload_evidence_to_r2.py fall back to / require reading
# data/real_docs/ straight off disk. Found in the Cloudflare dashboard
# under R2 > Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
